SHLINK_API_URL=https://links.example/rest/v3
SHLINK_API_KEY=
# Or mount a file and set SHLINK_API_KEY_FILE instead.
# Optional public base shown before custom aliases, for example https://short.com/
SHLINK_SHORT_URL_BASE=https://short.com/
COMPANION_APP_NAME=Link Shortener
COMPANION_ACCENT_COLOR=#86E7B7
COMPANION_MAIN_COLOR=#101827
COMPANION_ADMIN_PASSWORD=
COMPANION_USER_PASSWORD=
# LessonCue uses this one-shot JSON control file to update both stored hashes.
# Do not set COMPANION_*_PASSWORD in that deployment: env values override UI changes.
COMPANION_PASSWORD_RESET_FILE=
