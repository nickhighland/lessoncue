{
  "name": "lessoncue",
  "version": "0.40.16",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:admin",
    "build": "npm run build:admin",
    "dev:admin": "vite --config web-admin/vite.config.ts",
    "build:admin": "vite build --config web-admin/vite.config.ts",
    "typecheck:admin": "tsc -p web-admin/tsconfig.json",
    "test": "npm run typecheck:admin && npm run build:admin",
    "test:protocol": "node scripts/validate-protocol-contract.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/browser/zz-accessibility.spec.ts",
    "lint": "eslint \"web-admin/**/*.{ts,tsx}\"",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@microsoft/signalr": "^9.0.6",
    "hls.js": "^1.6.16",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.1.4"
  },
  "type": "module"
}
