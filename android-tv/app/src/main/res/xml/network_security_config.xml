<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Application code only accepts cleartext loopback, private/link-local,
         and .local origins. User CAs support an administrator-owned local
         HTTPS reverse proxy. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
