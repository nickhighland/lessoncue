LESSONCUE_HTTP_PORT=80
LESSONCUE_CPUS=2.0
# Set to 1 only when the Docker host blocks nested Bubblewrap namespaces.
# Native Linux installations should keep the stronger default (0).
LESSONCUE_MEDIA_WORKER_SKIP_SANDBOX=0
LESSONCUE_DATA_PATH=./lessoncue-data
LESSONCUE_SERVER_NAME=LessonCue
LESSONCUE_TIME_ZONE=America/New_York
