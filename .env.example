LESSONCUE_HTTP_PORT=80
LESSONCUE_CPUS=2.0
# Docker's outer container is the isolation boundary by default. Set to 0
# only on a host that explicitly permits nested Bubblewrap namespaces.
LESSONCUE_MEDIA_WORKER_SKIP_SANDBOX=1
LESSONCUE_DATA_PATH=./lessoncue-data
LESSONCUE_SERVER_NAME=LessonCue
LESSONCUE_TIME_ZONE=America/New_York
