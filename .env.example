LESSONCUE_HTTP_PORT=80
LESSONCUE_CPUS=2.0
# Docker's outer container is the isolation boundary by default. Set to 0
# only on a host that explicitly permits nested Bubblewrap namespaces.
LESSONCUE_MEDIA_WORKER_SKIP_SANDBOX=1
LESSONCUE_DATA_PATH=./lessoncue-data
LESSONCUE_SERVER_NAME=LessonCue
LESSONCUE_TIME_ZONE=America/New_York

# Optional Docker-host tunnel. In Cloudflare, point the remotely managed
# hostname route at http://lessoncue:8080 and start the profile with:
#   docker compose --profile cloudflare-tunnel up -d
# Keep the token in the host's secret store; it is mounted read-only and is
# never placed in the process command line.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.3
CLOUDFLARE_TUNNEL_TOKEN_FILE=./lessoncue-data/config/cloudflare/tunnel-token
