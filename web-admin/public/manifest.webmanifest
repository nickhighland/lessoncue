{
  "name": "LessonCue Controller",
  "short_name": "LessonCue",
  "description": "Control local LessonCue playback from a phone or tablet.",
  "start_url": "/universalremote",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f6f5f0",
  "theme_color": "#262f2c",
  "icons": [
    {
      "src": "/lessoncue-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/lessoncue-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/lessoncue-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
