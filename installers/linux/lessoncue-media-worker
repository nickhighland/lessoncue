#!/usr/bin/env bash
set -euo pipefail

network=deny
timeout_seconds=14400
memory_bytes=2147483648
file_bytes=21474836480
write_roots=()

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --network=allow) network=allow; shift ;;
    --network=deny) network=deny; shift ;;
    --timeout=*) timeout_seconds="${1#*=}"; shift ;;
    --memory=*) memory_bytes="${1#*=}"; shift ;;
    --file-size=*) file_bytes="${1#*=}"; shift ;;
    --write-root=*) write_roots+=("${1#*=}"); shift ;;
    --) shift; break ;;
    *) echo "Unknown LessonCue worker option: $1" >&2; exit 64 ;;
  esac
done

if [[ "$#" -lt 1 ]]; then
  echo "LessonCue worker received no executable." >&2
  exit 64
fi
if [[ ! "${timeout_seconds}" =~ ^[1-9][0-9]{0,5}$ ]] ||
   [[ ! "${memory_bytes}" =~ ^[1-9][0-9]{6,}$ ]] ||
   [[ ! "${file_bytes}" =~ ^[1-9][0-9]{6,}$ ]]; then
  echo "LessonCue worker limits are invalid." >&2
  exit 64
fi
# The service needs CAP_NET_BIND_SERVICE to open port 80, but media tools must
# never inherit a usable capability. ConstrainedProcessRunner clears the
# ambient and inheritable sets before exec; a normal exec then clears effective
# and permitted capabilities too. Keep this assertion next to the worker so a
# future service or launcher change fails closed instead of running a privileged
# converter. The root-only installer probe is intentionally exempt.
if [[ "${EUID}" -ne 0 && -r /proc/self/status ]]; then
  for capability_set in CapInh CapPrm CapEff CapAmb; do
    capability_value="$(awk -v name="${capability_set}:" '$1 == name { print $2 }' /proc/self/status)"
    if [[ -z "${capability_value}" || ! "${capability_value}" =~ ^0+$ ]]; then
      echo "LessonCue refused to start a media tool with inherited Linux capabilities." >&2
      exit 78
    fi
  done
fi

data_path="${LESSONCUE_DATA_PATH:-/var/lib/lessoncue}"
data_path="$(readlink -f "${data_path}")"
if [[ ! -d "${data_path}" ]]; then
  echo "LessonCue media storage is unavailable." >&2
  exit 78
fi

first_write=
if ((${#write_roots[@]} > 0)); then
  for root in "${write_roots[@]}"; do
    canonical="$(readlink -f "${root}")"
    case "${canonical}" in
      "${data_path}"/*|/tmp/lessoncue-*) ;;
      *) echo "LessonCue refused an unsafe media-worker write path." >&2; exit 64 ;;
    esac
    if [[ ! -d "${canonical}" ]]; then
      echo "LessonCue media-worker write path does not exist." >&2
      exit 64
    fi
    if [[ -z "${first_write}" ]]; then first_write="${canonical}"; fi
  done
fi

if [[ -n "${first_write}" ]]; then
  export HOME="${first_write}"
  export XDG_CACHE_HOME="${first_write}"
  cd "${first_write}"
else
  export HOME=/tmp
  export XDG_CACHE_HOME=/tmp
  cd /tmp
fi

worker=(
  /usr/bin/timeout --signal=TERM --kill-after=10s "${timeout_seconds}s"
  /usr/bin/prlimit
  "--cpu=${timeout_seconds}"
  "--as=${memory_bytes}"
  "--fsize=${file_bytes}"
  --nofile=256
)
# Native Linux intentionally uses the same direct worker path everywhere. The
# old Bubblewrap namespace made ordinary media processing depend on kernel
# user/mount namespace policy and was the source of repeated production
# failures. The systemd service or container supplies the process/task boundary
# (TasksMax/pids_limit), while this helper retains per-process resource limits.
# Do not use prlimit --nproc here: RLIMIT_NPROC is per real UID, not per worker,
# so a low value also limits the LessonCue server's .NET and FFmpeg threads.
worker+=(-- "$@")
exec "${worker[@]}"
