case "$(uname -m)" in
  x86_64|amd64) RUNTIME=linux-x64 ;;
  aarch64|arm64) RUNTIME=linux-arm64 ;;
  *) fail_update "Unsupported CPU architecture: $(uname -m)" ;;
esac

CURRENT_VERSION="$(cat /var/lib/lessoncue/config/installed-version 2>/dev/null || true)"
if [[ -z "${CURRENT_VERSION}" && -x /opt/lessoncue/LessonCue.Server ]]; then
  CURRENT_VERSION="$(/opt/lessoncue/LessonCue.Server --version 2>/dev/null || true)"
fi
if [[ -z "${CURRENT_VERSION}" ]]; then CURRENT_VERSION=unknown; fi

REPOSITORY="${LESSONCUE_UPDATE_REPOSITORY:-https://github.com/nickhighland/lessoncue}"
if [[ -n "${LESSONCUE_UPDATE_VERSION:-}" ]]; then
  VERSION="${LESSONCUE_UPDATE_VERSION}"
elif [[ "${REQUEST}" =~ ^update:(v?[0-9]+\.[0-9]+\.[0-9]+)(:|$) ]]; then
  VERSION="${BASH_REMATCH[1]}"
  if [[ "${VERSION}" != v* ]]; then VERSION="v${VERSION}"; fi
else
  VERSION_URL="$(curl -fsSL -o /dev/null -w '%{url_effective}' "${REPOSITORY}/releases/latest")"
  VERSION="${VERSION_URL##*/}"
fi
if [[ "${VERSION}" != v* ]]; then VERSION="v${VERSION}"; fi
if [[ ! "${VERSION}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z]+)*$ ]]; then
  fail_update "LessonCue rejected the requested release version because it was not a valid version tag."
fi
ASSET="LessonCue-Server-${RUNTIME}.tar.gz"
if [[ "${BOOTSTRAP_ACTIVE}" == true ]]; then
  WORKDIR="${LESSONCUE_UPDATE_VERIFIED_WORKDIR}"
  if [[ ! "${WORKDIR}" =~ ^/var/lib/lessoncue/\.update\.[0-9A-Za-z]+$ ]] ||
     [[ ! -d "${WORKDIR}" || -L "${WORKDIR}" ]] ||
     [[ "$(stat -c '%u:%a' -- "${WORKDIR}" 2>/dev/null || true)" != "0:700" ]]; then
    fail_update "The verified release updater rejected an unsafe protected bootstrap work directory."
  fi
  echo "Continuing LessonCue ${VERSION} with the verified release updater..."
else
  WORKDIR="$(mktemp -d /var/lib/lessoncue/.update.XXXXXXXX)"
fi
trap 'rm -rf "${WORKDIR}" "${STAGED}"' EXIT

if [[ "${BOOTSTRAP_ACTIVE}" != true ]]; then
  echo "Downloading LessonCue ${VERSION} for ${RUNTIME}..."
  curl -fL "${REPOSITORY}/releases/download/${VERSION}/${ASSET}" -o "${WORKDIR}/${ASSET}"
  curl -fL "${REPOSITORY}/releases/download/${VERSION}/SHA256SUMS" -o "${WORKDIR}/SHA256SUMS"
  curl -fL "${REPOSITORY}/releases/download/${VERSION}/SHA256SUMS.sig" -o "${WORKDIR}/SHA256SUMS.sig"
elif [[ ! -f "${WORKDIR}/${ASSET}" || ! -f "${WORKDIR}/SHA256SUMS" ||
        ! -f "${WORKDIR}/SHA256SUMS.sig" || ! -d "${WORKDIR}/archive" ]]; then
  fail_update "The verified release updater could not resume because its downloaded release bundle was incomplete."
fi
RELEASE_PUBLIC_KEY="${LESSONCUE_RELEASE_PUBLIC_KEY:-/etc/lessoncue/release-signing-public.pem}"
if [[ ! -f "${RELEASE_PUBLIC_KEY}" ]]; then
  fail_update "The pinned LessonCue release-signing public key is missing. Run the current SSH installer once before using browser updates."
fi
if ! openssl pkeyutl -verify -pubin -inkey "${RELEASE_PUBLIC_KEY}" \
  -rawin -in "${WORKDIR}/SHA256SUMS" \
  -sigfile "${WORKDIR}/SHA256SUMS.sig"; then
  fail_update "LessonCue rejected this release because its Ed25519 signature is invalid."
fi
if ! grep -F "  ${ASSET}" "${WORKDIR}/SHA256SUMS" > "${WORKDIR}/asset.sha256"; then
  fail_update "The release does not contain a checksum for ${ASSET}."
fi
(cd "${WORKDIR}" && sha256sum -c asset.sha256)

if [[ "${BOOTSTRAP_ACTIVE}" != true ]]; then
  mkdir "${WORKDIR}/archive"
  tar -xzf "${WORKDIR}/${ASSET}" -C "${WORKDIR}/archive"
fi
if [[ ! -x "${WORKDIR}/archive/payload/LessonCue.Server" ]]; then
  fail_update "The release archive is missing LessonCue.Server."
fi
if [[ ! -f "${WORKDIR}/archive/lessoncue-render.rules" ]]; then
  fail_update "The release archive is missing the Intel render-device rule."
fi
if [[ ! -x "${WORKDIR}/archive/lessoncue-media-worker" ]]; then
  fail_update "The release archive is missing the LessonCue media worker."
fi
if [[ ! -x "${WORKDIR}/archive/lessoncue-update" ]]; then
  fail_update "The release archive is missing the protected LessonCue updater."
fi

# The signed archive may contain a newer updater than the one systemd started.
# Run that verified candidate directly from the release bundle before taking
# any snapshot. The parent keeps the operation lock, and the candidate reuses
# the already verified bundle and original request. It remains temporary until
# the protected transaction installs it or reports a precise failure.
if [[ "${BOOTSTRAP_ACTIVE}" != true ]] &&
   ! cmp -s "${WORKDIR}/archive/lessoncue-update" /usr/local/sbin/lessoncue-update; then
  echo "Handing the protected operation to the verified release updater before snapshotting..."
  if LESSONCUE_UPDATE_BOOTSTRAPPED=true \
     LESSONCUE_UPDATE_REQUEST="${REQUEST}" \
     LESSONCUE_UPDATE_VERIFIED_WORKDIR="${WORKDIR}" \
     LESSONCUE_UPDATE_VERSION="${VERSION}" \
     LESSONCUE_UPDATE_REPOSITORY="${REPOSITORY}" \
     LESSONCUE_RELEASE_PUBLIC_KEY="${RELEASE_PUBLIC_KEY}" \
     "${WORKDIR}/archive/lessoncue-update"; then
    exit 0
  else
    bootstrap_exit=$?
    exit "${bootstrap_exit}"
  fi
fi

rm -rf "${STAGED}"
install -d "${STAGED}"
cp -a "${WORKDIR}/archive/payload/." "${STAGED}/"
chown -R root:root "${STAGED}"

# Stop all writers before taking a consistent database/configuration snapshot.
systemctl stop lessoncue.service
if ! prepare_update_snapshot; then
  snapshot_reason="${SNAPSHOT_FAILURE_REASON:-an unknown protected snapshot step failed}"
  echo "Pre-update snapshot failed: ${snapshot_reason}" >&2
  rm -rf "${ROLLBACK_ROOT}.new" ||
    echo "Pre-update snapshot cleanup also failed." >&2
  systemctl start lessoncue.service || true
  write_update_result false "${VERSION}" \
    "LessonCue could not create and verify the required pre-update snapshot. Snapshot detail: ${snapshot_reason}. The existing installation was not changed."
  echo "The update was cancelled because the pre-update snapshot could not be created."
  exit 1
fi

rm -rf "${PREVIOUS}" "${FAILED}"
printf 'update:%s:%s\n' "${VERSION}" "$(date --iso-8601=seconds)" > "${TRANSACTION_MARKER}"
chmod 0600 "${TRANSACTION_MARKER}"
UPDATE_TRANSACTION_ACTIVE=true

# Refresh protected executables and units only after the archive and rollback
# snapshot have both passed validation.
install -d -o root -g root -m 0755 "$(dirname "${MEDIA_WORKER}")"
install -o root -g root -m 0755 "${WORKDIR}/archive/lessoncue-media-worker" "${MEDIA_WORKER}"
install -d -o root -g root -m 0755 "$(dirname "${MEDIA_RENDER_RULE}")"
install -o root -g root -m 0644 "${WORKDIR}/archive/lessoncue-render.rules" "${MEDIA_RENDER_RULE}"
refresh_render_device_rules
install -m 0755 "${WORKDIR}/archive/lessoncue-update" /usr/local/sbin/lessoncue-update
install -m 0644 "${WORKDIR}/archive/lessoncue-update.service" /etc/systemd/system/lessoncue-update.service
install -m 0644 "${WORKDIR}/archive/lessoncue-update.path" /etc/systemd/system/lessoncue-update.path
install -m 0644 "${WORKDIR}/archive/lessoncue-update-recovery.service" /etc/systemd/system/lessoncue-update-recovery.service
install -m 0644 "${WORKDIR}/archive/lessoncue.service" /etc/systemd/system/lessoncue.service
install -m 0644 "${WORKDIR}/archive/lessoncue-cloudflared.service" /etc/systemd/system/lessoncue-cloudflared.service
systemctl daemon-reload
systemctl enable lessoncue-update-recovery.service

# Older installations may have a root-owned media parent even though their
# existing media subdirectories belong to the service account. Repair the
# parent and provision relay storage before the upgraded server starts.
install -d -o lessoncue -g lessoncue -m 0750 \
  /var/lib/lessoncue/media \
  /var/lib/lessoncue/media/live-streams

if [[ -f /etc/lessoncue/cloudflare-token ]] &&
   grep -Eq '"enabled"[[:space:]]*:[[:space:]]*true' /var/lib/lessoncue/config/cloudflare-tunnel.json 2>/dev/null; then
  # Repair older releases that disabled the connector after a short first
  # handshake timeout. The existing protected credential remains in place.
  systemctl enable --now lessoncue-cloudflared.service >/dev/null 2>&1 || true
else
  systemctl try-restart lessoncue-cloudflared.service >/dev/null 2>&1 || true
fi

if [[ -d /opt/lessoncue ]]; then
  mv /opt/lessoncue "${PREVIOUS}"
  APP_SWAPPED=true
fi
mv "${STAGED}" /opt/lessoncue

# The optional URL shortener, if this installation asked for one. It lives
# beside /opt/lessoncue rather than inside it, because that directory is
# replaced wholesale here. Never fatal: a shortener that will not start is not
# a reason to fail an update of the server.
update_shortener() {
  local marker=/var/lib/lessoncue/config/shortener-domain
  local dir=/opt/lessoncue-shortener
  local name=LessonCue-URL-Shortener.tar.gz
  local bundle="${WORKDIR}/${name}"

  [[ -s "${marker}" ]] || return 0
  local domain
  domain="$(tr -d '[:space:]' < "${marker}")"
  [[ -n "${domain}" ]] || return 0

  if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
    echo "URL shortener requested for ${domain}, but Docker with the Compose plugin is not installed."
    return 0
  fi

  # Fetched and checked against the same signed SHA256SUMS the server asset
  # used, which this point in the update has already verified.
  if [[ ! -f "${bundle}" ]]; then
    curl -fL "${REPOSITORY}/releases/download/${VERSION}/${name}" -o "${bundle}" 2>/dev/null || true
  fi
  if [[ -f "${bundle}" ]]; then
    if grep -F "  ${name}" "${WORKDIR}/SHA256SUMS" > "${WORKDIR}/shortener.sha256" 2>/dev/null; then
      ( cd "${WORKDIR}" && sha256sum -c shortener.sha256 >/dev/null ) || rm -f "${bundle}"
    else
      rm -f "${bundle}"
    fi
  fi

  # Refresh the definition from this release so compose changes reach servers.
  if [[ -f "${bundle}" ]]; then
    install -d -m 755 "${dir}"
    tar -xzf "${bundle}" -C "${dir}" --strip-components=1 || true
    chmod +x "${dir}"/*.sh 2>/dev/null || true
  fi

  if [[ -x "${dir}/install.sh" ]]; then
    install -d -m 750 /var/lib/lessoncue/shortener
    ( cd "${dir}" \
      && SHORTENER_DATA_DIR=/var/lib/lessoncue/shortener \
         LESSONCUE_DATA_PATH=/var/lib/lessoncue \
         SHORT_DOMAIN_ROOT_REDIRECT="$(cat /var/lib/lessoncue/config/shortener-root-redirect 2>/dev/null || true)" \
         ./install.sh "${domain}" ) \
      || echo "The URL shortener did not come up. LessonCue itself is unaffected."
  fi
}
update_shortener || true

HTTP_PORT="$(cat /var/lib/lessoncue/config/http-port 2>/dev/null || printf '8080')"
if systemctl start lessoncue.service; then
  for ((attempt = 1; attempt <= READINESS_ATTEMPTS; attempt++)); do
    if curl -fsS "http://127.0.0.1:${HTTP_PORT}/health/ready" >/dev/null; then
      UPDATE_TRANSACTION_ACTIVE=false
      printf '%s\n' "${VERSION#v}" > /var/lib/lessoncue/config/installed-version
      chown lessoncue:lessoncue /var/lib/lessoncue/config/installed-version
      chmod 0600 /var/lib/lessoncue/config/installed-version
      rm -f "${TRANSACTION_MARKER}"
      write_update_result true "${VERSION}" \
        "LessonCue installed the update successfully. A protected last-known-good rollback snapshot is available."
      echo "LessonCue ${VERSION} installed successfully."
      exit 0
    fi
    sleep "${READINESS_DELAY_SECONDS}"
  done
fi

echo "The updated server did not become ready. Restoring the complete previous installation."
restore_update_snapshot || true
exit 1
