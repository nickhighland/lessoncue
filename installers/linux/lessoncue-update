#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  echo "LessonCue updater must run as root."
  exit 1
fi

# Older installers could leave the protected-operation directory owned by root.
# Repair only the updater-owned paths before the application needs to write its
# next request, without changing ownership of application data or secrets.
if id lessoncue >/dev/null 2>&1; then
  install -d -o lessoncue -g lessoncue -m 0700 /var/lib/lessoncue/config
  for result_path in /var/lib/lessoncue/config/update-request /var/lib/lessoncue/config/update-result.json; do
    if [[ -e "${result_path}" ]]; then
      chown lessoncue:lessoncue "${result_path}"
      chmod 0600 "${result_path}"
    fi
  done
fi

REQUEST_PATH=/var/lib/lessoncue/config/update-request
UPDATE_RESULT_PATH=/var/lib/lessoncue/config/update-result.json
UPDATE_RESULT_WRITTEN=false
BOOTSTRAP_ACTIVE="${LESSONCUE_UPDATE_BOOTSTRAPPED:-false}"

write_update_result() {
  local success="$1" version="$2" message="$3"
  local temporary escaped_version escaped_message
  escaped_version="${version//\\/\\\\}"
  escaped_version="${escaped_version//\"/\\\"}"
  escaped_message="${message//\\/\\\\}"
  escaped_message="${escaped_message//\"/\\\"}"
  escaped_message="${escaped_message//$'\n'/\\n}"
  temporary="$(mktemp)"
  printf '{"success":%s,"version":"%s","message":"%s","completedAt":"%s"}\n' \
    "${success}" "${escaped_version}" "${escaped_message}" "$(date --iso-8601=seconds)" > "${temporary}"
  install -o lessoncue -g lessoncue -m 0600 "${temporary}" "${UPDATE_RESULT_PATH}"
  rm -f "${temporary}"
  UPDATE_RESULT_WRITTEN=true
}

if [[ "${BOOTSTRAP_ACTIVE}" != true ]]; then
  exec 9>/run/lessoncue-update.lock
  if ! flock -n 9; then
    REQUEST="$(head -n 1 "${REQUEST_PATH}" 2>/dev/null || true)"
    if [[ "${REQUEST}" == update:* || "${REQUEST}" == rollback:* ]]; then
      write_update_result false "unknown" \
        "Another protected LessonCue operation is already in progress. This request was not started; try again after the active operation finishes."
      rm -f "${REQUEST_PATH}"
    fi
    echo "Another LessonCue update is already running."
    exit 0
  fi
fi
RECOVERY_ONLY=false
if [[ "${1:-}" == "--recover" ]]; then RECOVERY_ONLY=true; fi
if [[ "$(uname -m)" =~ ^(x86_64|amd64)$ ]] && id lessoncue >/dev/null 2>&1; then
  for device_group in render video; do
    if getent group "${device_group}" >/dev/null 2>&1; then usermod -a -G "${device_group}" lessoncue; fi
  done
fi

if [[ "${BOOTSTRAP_ACTIVE}" == true ]]; then
  REQUEST="${LESSONCUE_UPDATE_REQUEST:-}"
  if [[ "${REQUEST}" != update:* || -z "${LESSONCUE_UPDATE_VERIFIED_WORKDIR:-}" ]]; then
    write_update_result false "unknown" \
      "The verified release updater could not resume because its protected bootstrap context was incomplete."
    exit 1
  fi
elif [[ "${RECOVERY_ONLY}" == true ]]; then
  REQUEST=""
else
  REQUEST="$(head -n 1 "${REQUEST_PATH}" 2>/dev/null || true)"
  rm -f "${REQUEST_PATH}"
fi

ROLLBACK_ROOT=/var/lib/lessoncue/update-rollback
MANUAL_SAFETY_ROOT=/var/lib/lessoncue/manual-rollback-safety
TRANSACTION_MARKER=/var/lib/lessoncue/update-transaction
STAGED=/opt/lessoncue.new
PREVIOUS=/opt/lessoncue.previous
FAILED=/opt/lessoncue.failed
ROLLBACK_REJECTED=/opt/lessoncue.rollback-rejected
MEDIA_WORKER=/usr/local/libexec/lessoncue-media-worker
MEDIA_RENDER_RULE=/etc/udev/rules.d/99-lessoncue-render.rules
SNAPSHOT_FAILURE_REASON=""
UPDATE_TRANSACTION_ACTIVE=false
APP_SWAPPED=false
READINESS_ATTEMPTS="${LESSONCUE_UPDATE_READINESS_ATTEMPTS:-30}"
READINESS_DELAY_SECONDS="${LESSONCUE_UPDATE_READINESS_DELAY_SECONDS:-2}"
if [[ ! "${READINESS_ATTEMPTS}" =~ ^[1-9][0-9]*$ ]]; then READINESS_ATTEMPTS=30; fi
if [[ ! "${READINESS_DELAY_SECONDS}" =~ ^[0-9]+$ ]]; then READINESS_DELAY_SECONDS=2; fi

is_update_request() {
  [[ "${REQUEST}" == update:* || "${REQUEST}" == rollback:* ]]
}

protected_operation_name() {
  if [[ "${REQUEST}" == rollback:* ]]; then
    printf 'rollback'
  else
    printf 'update'
  fi
}

fail_update() {
  local message="$1"
  echo "${message}"
  write_update_result false "${VERSION:-unknown}" "${message}" || true
  exit 1
}

snapshot_failure() {
  SNAPSHOT_FAILURE_REASON="$1"
  return 1
}

# SQLite can create -wal and -shm sidecars even when a database is opened in
# read-only mode. Run integrity checks against a disposable copy so validating
# a protected snapshot can never change the snapshot that will be compared or
# restored.
verify_database_copy() {
  local source_directory="$1" verifier="$2" verification_directory result=0
  verification_directory="$(mktemp -d /var/lib/lessoncue/.database-verification.XXXXXXXX)" || return 1
  if ! cp -a "${source_directory}/." "${verification_directory}/"; then
    result=1
  elif ! "${verifier}" --verify-database "${verification_directory}/lessoncue.db"; then
    result=1
  fi
  if ! rm -rf -- "${verification_directory}"; then result=1; fi
  return "${result}"
}

snapshot_path() {
  local source="$1" root="${2:-${ROLLBACK_ROOT}}" relative="${1#/}" destination="${2:-${ROLLBACK_ROOT}}/system/${1#/}"
  if [[ -e "${source}" || -L "${source}" ]]; then
    if ! mkdir -p "$(dirname "${destination}")"; then
      snapshot_failure "could not create the protected snapshot directory for ${source}"
      return 1
    fi
    if ! cp -a "${source}" "${destination}"; then
      snapshot_failure "could not copy protected path ${source}"
      return 1
    fi
  else
    if ! mkdir -p "${root}/missing/$(dirname "${relative}")" ||
       ! : > "${root}/missing/${relative}"; then
      snapshot_failure "could not record missing protected path ${source}"
      return 1
    fi
  fi
}

restore_path() {
  local target="$1" root="${2:-${ROLLBACK_ROOT}}" relative="${1#/}" source="${2:-${ROLLBACK_ROOT}}/system/${1#/}"
  if [[ -e "${source}" || -L "${source}" ]]; then
    rm -rf "${target}"
    mkdir -p "$(dirname "${target}")"
    cp -a "${source}" "${target}"
  elif [[ -e "${root}/missing/${relative}" ]]; then
    rm -rf "${target}"
  fi
}

refresh_render_device_rules() {
  if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules >/dev/null 2>&1 || true
    udevadm trigger --subsystem-match=drm >/dev/null 2>&1 || true
  fi
}

prepare_update_snapshot() {
  local temporary="${ROLLBACK_ROOT}.new"
  SNAPSHOT_FAILURE_REASON=""
  if ! rm -rf "${temporary}"; then
    snapshot_failure "could not clear the temporary protected snapshot directory"
    return 1
  fi
  if ! install -d -o root -g root -m 0700 "${temporary}/data"; then
    snapshot_failure "could not create the temporary protected snapshot directory"
    return 1
  fi
  if [[ -d /var/lib/lessoncue/database ]] &&
     ! cp -a /var/lib/lessoncue/database "${temporary}/data/database"; then
    snapshot_failure "could not copy the database into the protected snapshot"
    return 1
  fi
  if [[ -d /var/lib/lessoncue/config ]] &&
     ! cp -a /var/lib/lessoncue/config "${temporary}/data/config"; then
    snapshot_failure "could not copy the configuration into the protected snapshot"
    return 1
  fi
  if [[ ! -f "${temporary}/data/database/lessoncue.db" ]]; then
    snapshot_failure "the protected snapshot is missing the database file"
    return 1
  fi
  if ! verify_database_copy "${temporary}/data/database" "${STAGED}/LessonCue.Server"; then
    snapshot_failure "the staged server rejected the protected database snapshot"
    return 1
  fi
  if [[ -d /var/lib/lessoncue/database ]] &&
     ! diff -qr /var/lib/lessoncue/database "${temporary}/data/database" >/dev/null; then
    snapshot_failure "the database changed or could not be compared while snapshotting"
    return 1
  fi
  if [[ -d /var/lib/lessoncue/config ]] &&
     ! diff -qr /var/lib/lessoncue/config "${temporary}/data/config" >/dev/null; then
    snapshot_failure "the configuration changed or could not be compared while snapshotting"
    return 1
  fi
  snapshot_path /usr/local/sbin/lessoncue-update "${temporary}" || return 1
  snapshot_path /etc/systemd/system/lessoncue-update.service "${temporary}" || return 1
  snapshot_path /etc/systemd/system/lessoncue-update.path "${temporary}" || return 1
  snapshot_path /etc/systemd/system/lessoncue-update-recovery.service "${temporary}" || return 1
  snapshot_path /etc/systemd/system/multi-user.target.wants/lessoncue-update-recovery.service "${temporary}" || return 1
  snapshot_path /etc/systemd/system/lessoncue.service "${temporary}" || return 1
  snapshot_path /etc/systemd/system/lessoncue-cloudflared.service "${temporary}" || return 1
  snapshot_path "${MEDIA_WORKER}" "${temporary}" || return 1
  snapshot_path "${MEDIA_RENDER_RULE}" "${temporary}" || return 1
  snapshot_path /etc/lessoncue "${temporary}" || return 1
  if ! printf '%s\n' "${CURRENT_VERSION:-unknown}" > "${temporary}/from-version"; then
    snapshot_failure "could not write the protected snapshot source version"
    return 1
  fi
  if ! printf '%s\n' "${VERSION:-unknown}" > "${temporary}/to-version"; then
    snapshot_failure "could not write the protected snapshot target version"
    return 1
  fi
  if ! date --iso-8601=seconds > "${temporary}/created-at"; then
    snapshot_failure "could not write the protected snapshot timestamp"
    return 1
  fi
  if ! rm -rf "${ROLLBACK_ROOT}"; then
    snapshot_failure "could not clear the previous protected snapshot"
    return 1
  fi
  if ! mv "${temporary}" "${ROLLBACK_ROOT}"; then
    snapshot_failure "could not finalize the protected snapshot directory"
    return 1
  fi
}

restore_update_snapshot() {
  local operation="${1:-update}" restored=true
  set +e
  systemctl stop lessoncue.service >/dev/null 2>&1

  if [[ "${APP_SWAPPED}" == true ]]; then
    rm -rf "${FAILED}"
    if [[ -d /opt/lessoncue ]]; then mv /opt/lessoncue "${FAILED}"; fi
    if [[ -d "${PREVIOUS}" ]]; then mv "${PREVIOUS}" /opt/lessoncue; else restored=false; fi
  fi

  if [[ -d "${ROLLBACK_ROOT}/data/database" ]]; then
    rm -rf /var/lib/lessoncue/database
    cp -a "${ROLLBACK_ROOT}/data/database" /var/lib/lessoncue/database || restored=false
  fi
  if [[ -d "${ROLLBACK_ROOT}/data/config" ]]; then
    rm -rf /var/lib/lessoncue/config
    cp -a "${ROLLBACK_ROOT}/data/config" /var/lib/lessoncue/config || restored=false
    rm -f /var/lib/lessoncue/config/update-request
  fi
  chown -R lessoncue:lessoncue /var/lib/lessoncue/database /var/lib/lessoncue/config 2>/dev/null || restored=false

  restore_path /usr/local/sbin/lessoncue-update || restored=false
  restore_path /etc/systemd/system/lessoncue-update.service || restored=false
  restore_path /etc/systemd/system/lessoncue-update.path || restored=false
  restore_path /etc/systemd/system/lessoncue-update-recovery.service || restored=false
  restore_path /etc/systemd/system/multi-user.target.wants/lessoncue-update-recovery.service || restored=false
  restore_path /etc/systemd/system/lessoncue.service || restored=false
  restore_path /etc/systemd/system/lessoncue-cloudflared.service || restored=false
  restore_path "${MEDIA_WORKER}" || restored=false
  restore_path "${MEDIA_RENDER_RULE}" || restored=false
  refresh_render_device_rules
  restore_path /etc/lessoncue || restored=false
  systemctl daemon-reload || restored=false

  local rollback_port
  rollback_port="$(cat /var/lib/lessoncue/config/http-port 2>/dev/null || printf '80')"
  if [[ "${restored}" == true ]] && systemctl start lessoncue.service; then
    for ((attempt = 1; attempt <= READINESS_ATTEMPTS; attempt++)); do
      if curl -fsS "http://127.0.0.1:${rollback_port}/health/ready" >/dev/null; then
        UPDATE_TRANSACTION_ACTIVE=false
        rm -f "${TRANSACTION_MARKER}"
        if [[ "${operation}" == "manual" ]]; then
          write_update_result true "${VERSION:-unknown}" \
            "LessonCue restored the protected last-known-good application, database, configuration, updater, and service units."
        else
          write_update_result false "${VERSION:-unknown}" \
            "The update was interrupted or failed. LessonCue restored the previous application, database, configuration, updater, and service units."
        fi
        set -e
        return 0
      fi
      sleep "${READINESS_DELAY_SECONDS}"
    done
  fi

  write_update_result false "${VERSION:-unknown}" \
    "The protected operation failed and the previous installation could not be restored automatically. Keep the server online and inspect journalctl -u lessoncue-update.service."
  set -e
  return 1
}

prepare_manual_rollback_safety() {
  local temporary="${MANUAL_SAFETY_ROOT}.new"
  rm -rf "${temporary}"
  install -d -o root -g root -m 0700 "${temporary}/data" || return 1
  if [[ -d /var/lib/lessoncue/database ]]; then cp -a /var/lib/lessoncue/database "${temporary}/data/database" || return 1; fi
  if [[ -d /var/lib/lessoncue/config ]]; then cp -a /var/lib/lessoncue/config "${temporary}/data/config" || return 1; fi
  if [[ ! -f "${temporary}/data/database/lessoncue.db" ]] ||
     ! verify_database_copy "${temporary}/data/database" /opt/lessoncue/LessonCue.Server; then
    return 1
  fi
  if ! diff -qr /var/lib/lessoncue/database "${temporary}/data/database" >/dev/null ||
     ! diff -qr /var/lib/lessoncue/config "${temporary}/data/config" >/dev/null; then
    return 1
  fi
  rm -rf "${MANUAL_SAFETY_ROOT}"
  mv "${temporary}" "${MANUAL_SAFETY_ROOT}" || return 1
  snapshot_path /usr/local/sbin/lessoncue-update "${MANUAL_SAFETY_ROOT}" || return 1
  snapshot_path /etc/systemd/system/lessoncue-update.service "${MANUAL_SAFETY_ROOT}" || return 1
  snapshot_path /etc/systemd/system/lessoncue-update.path "${MANUAL_SAFETY_ROOT}" || return 1
  snapshot_path /etc/systemd/system/lessoncue-update-recovery.service "${MANUAL_SAFETY_ROOT}" || return 1
  snapshot_path /etc/systemd/system/multi-user.target.wants/lessoncue-update-recovery.service "${MANUAL_SAFETY_ROOT}" || return 1
  snapshot_path /etc/systemd/system/lessoncue.service "${MANUAL_SAFETY_ROOT}" || return 1
  snapshot_path /etc/systemd/system/lessoncue-cloudflared.service "${MANUAL_SAFETY_ROOT}" || return 1
  snapshot_path "${MEDIA_WORKER}" "${MANUAL_SAFETY_ROOT}" || return 1
  snapshot_path "${MEDIA_RENDER_RULE}" "${MANUAL_SAFETY_ROOT}" || return 1
  snapshot_path /etc/lessoncue "${MANUAL_SAFETY_ROOT}" || return 1
  printf '%s\n' "${CURRENT_VERSION:-unknown}" > "${MANUAL_SAFETY_ROOT}/version" || return 1
  printf '%s\n' "$(date --iso-8601=seconds)" > "${MANUAL_SAFETY_ROOT}/created-at" || return 1
}

restore_manual_rollback_safety() {
  local restored=true safety_port
  set +e
  systemctl stop lessoncue.service >/dev/null 2>&1
  rm -rf "${ROLLBACK_REJECTED}"
  if [[ -d /opt/lessoncue ]]; then mv /opt/lessoncue "${ROLLBACK_REJECTED}"; fi
  if [[ -d "${FAILED}" ]]; then mv "${FAILED}" /opt/lessoncue; else restored=false; fi

  if [[ -d "${MANUAL_SAFETY_ROOT}/data/database" ]]; then
    rm -rf /var/lib/lessoncue/database
    cp -a "${MANUAL_SAFETY_ROOT}/data/database" /var/lib/lessoncue/database || restored=false
  fi
  if [[ -d "${MANUAL_SAFETY_ROOT}/data/config" ]]; then
    rm -rf /var/lib/lessoncue/config
    cp -a "${MANUAL_SAFETY_ROOT}/data/config" /var/lib/lessoncue/config || restored=false
    rm -f /var/lib/lessoncue/config/update-request
  fi
  chown -R lessoncue:lessoncue /var/lib/lessoncue/database /var/lib/lessoncue/config 2>/dev/null || restored=false

  restore_path /usr/local/sbin/lessoncue-update "${MANUAL_SAFETY_ROOT}" || restored=false
  restore_path /etc/systemd/system/lessoncue-update.service "${MANUAL_SAFETY_ROOT}" || restored=false
  restore_path /etc/systemd/system/lessoncue-update.path "${MANUAL_SAFETY_ROOT}" || restored=false
  restore_path /etc/systemd/system/lessoncue-update-recovery.service "${MANUAL_SAFETY_ROOT}" || restored=false
  restore_path /etc/systemd/system/multi-user.target.wants/lessoncue-update-recovery.service "${MANUAL_SAFETY_ROOT}" || restored=false
  restore_path /etc/systemd/system/lessoncue.service "${MANUAL_SAFETY_ROOT}" || restored=false
  restore_path /etc/systemd/system/lessoncue-cloudflared.service "${MANUAL_SAFETY_ROOT}" || restored=false
  restore_path "${MEDIA_WORKER}" "${MANUAL_SAFETY_ROOT}" || restored=false
  restore_path "${MEDIA_RENDER_RULE}" "${MANUAL_SAFETY_ROOT}" || restored=false
  refresh_render_device_rules
  restore_path /etc/lessoncue "${MANUAL_SAFETY_ROOT}" || restored=false
  systemctl daemon-reload || restored=false

  safety_port="$(cat /var/lib/lessoncue/config/http-port 2>/dev/null || printf '80')"
  if [[ "${restored}" == true ]] && systemctl start lessoncue.service; then
    for ((attempt = 1; attempt <= READINESS_ATTEMPTS; attempt++)); do
      if curl -fsS "http://127.0.0.1:${safety_port}/health/ready" >/dev/null; then
        rm -f "${TRANSACTION_MARKER}"
        UPDATE_TRANSACTION_ACTIVE=false
        write_update_result false "${CURRENT_VERSION:-unknown}" \
          "The requested rollback did not become ready. LessonCue restored the application, database, configuration, updater, and service units that were active before the rollback."
        set -e
        return 0
      fi
      sleep "${READINESS_DELAY_SECONDS}"
    done
  fi

  # Preserve the rejected last-known-good application as the previous
  # application so a boot-time recovery pass still has a complete pair to
  # work with if even the pre-rollback installation cannot become ready.
  if [[ -d "${ROLLBACK_REJECTED}" && ! -e "${PREVIOUS}" ]]; then
    mv "${ROLLBACK_REJECTED}" "${PREVIOUS}" || true
  fi
  write_update_result false "${CURRENT_VERSION:-unknown}" \
    "Rollback and automatic rollback recovery both failed. Keep the server online and inspect journalctl -u lessoncue-update.service. The protected manual rollback safety snapshot remains available."
  set -e
  return 1
}

perform_manual_rollback() {
  if [[ ! -d "${PREVIOUS}" || ! -f "${ROLLBACK_ROOT}/data/database/lessoncue.db" ]]; then
    write_update_result false "unknown" "No verified last-known-good update snapshot is available."
    return 1
  fi
  CURRENT_VERSION="$(cat /var/lib/lessoncue/config/installed-version 2>/dev/null || true)"
  if [[ -z "${CURRENT_VERSION}" ]]; then
    CURRENT_VERSION="$(/opt/lessoncue/LessonCue.Server --version 2>/dev/null || printf 'unknown')"
  fi
  VERSION="$(cat "${ROLLBACK_ROOT}/from-version" 2>/dev/null || printf 'unknown')"
  if ! verify_database_copy "${ROLLBACK_ROOT}/data/database" /opt/lessoncue/LessonCue.Server; then
    write_update_result false "${VERSION}" "The protected rollback database failed its integrity check. The current installation was not changed."
    return 1
  fi

  systemctl stop lessoncue.service
  if ! prepare_manual_rollback_safety; then
    systemctl start lessoncue.service || true
    write_update_result false "${VERSION}" \
      "LessonCue could not create and verify the required pre-rollback safety snapshot. The current installation was not changed."
    return 1
  fi

  printf 'manual:%s\n' "$(date --iso-8601=seconds)" > "${TRANSACTION_MARKER}"
  chmod 0600 "${TRANSACTION_MARKER}"
  UPDATE_TRANSACTION_ACTIVE=true
  APP_SWAPPED=true
  if restore_update_snapshot manual; then return 0; fi
  restore_manual_rollback_safety
}

handle_update_error() {
  local code="$1"
  local operation message
  set +e
  if [[ "${UPDATE_TRANSACTION_ACTIVE}" == true ]]; then
    echo "The update was interrupted. Restoring the complete pre-update snapshot."
    restore_update_snapshot || true
  fi
  if is_update_request && [[ "${UPDATE_RESULT_WRITTEN}" != true ]]; then
    operation="$(protected_operation_name)"
    message="The protected ${operation} failed before it could complete (exit code ${code}). Inspect journalctl -u lessoncue-update.service for the failing command."
    write_update_result false "${VERSION:-unknown}" "${message}" || true
  fi
  set -e
  exit "${code}"
}

trap 'handle_update_error $?' ERR

if [[ -f "${TRANSACTION_MARKER}" ]]; then
  VERSION="$(cat "${ROLLBACK_ROOT}/from-version" 2>/dev/null || printf 'unknown')"
  UPDATE_TRANSACTION_ACTIVE=true
  if [[ -d "${PREVIOUS}" ]]; then APP_SWAPPED=true; fi
  echo "LessonCue found an interrupted protected operation. Restoring the last-known-good snapshot."
  restore_update_snapshot interrupted
  exit $?
fi

if [[ "${RECOVERY_ONLY}" == true ]]; then exit 0; fi
if [[ -z "${REQUEST}" ]]; then exit 0; fi
if [[ "${REQUEST}" == rollback:* ]]; then
  perform_manual_rollback
  exit $?
fi

format_address() {
  local hostname="$1" port="$2"
  if [[ "${port}" == "80" ]]; then printf 'http://%s.local' "${hostname}"; else printf 'http://%s.local:%s' "${hostname}" "${port}"; fi
}
set_avahi_port() {
  local port="$1" service=/etc/avahi/services/lessoncue.service temporary
  [[ -f "${service}" ]] || return 0
  temporary="$(mktemp)"
  sed -E "s#<port>[0-9]+</port>#<port>${port}</port>#; s#<txt-record>port=[0-9]+</txt-record>#<txt-record>port=${port}</txt-record>#" "${service}" > "${temporary}"
  if ! grep -q '<txt-record>port=' "${temporary}"; then
    sed -E "s#([[:space:]]*)</service>#\1  <txt-record>port=${port}</txt-record>\n\1</service>#" "${temporary}" > "${temporary}.port"
    mv "${temporary}.port" "${temporary}"
  fi
  install -m 0644 "${temporary}" "${service}"
  rm -f "${temporary}"
}
write_tunnel_result() {
  local enabled="$1" credential="$2" installed="$3" error="$4" result=/var/lib/lessoncue/config/cloudflare-result.json temporary
  temporary="$(mktemp)"
  if [[ -n "${error}" ]]; then
    printf '{"enabled":%s,"credentialConfigured":%s,"serviceInstalled":%s,"appliedAt":"%s","error":"%s"}\n' \
      "${enabled}" "${credential}" "${installed}" "$(date --iso-8601=seconds)" "${error}" > "${temporary}"
  else
    printf '{"enabled":%s,"credentialConfigured":%s,"serviceInstalled":%s,"appliedAt":"%s","error":null}\n' \
      "${enabled}" "${credential}" "${installed}" "$(date --iso-8601=seconds)" > "${temporary}"
  fi
  install -o lessoncue -g lessoncue -m 0600 "${temporary}" "${result}"
  rm -f "${temporary}"
}
install_tunnel_unit() {
  local temporary
  temporary="$(mktemp)"
  cat > "${temporary}" <<'LESSONCUE_TUNNEL_UNIT'
[Unit]
Description=LessonCue optional Cloudflare Tunnel connector
After=network-online.target lessoncue.service
Wants=network-online.target

[Service]
Type=simple
User=lessoncue-tunnel
Group=lessoncue-tunnel
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:60123 run --token-file /etc/lessoncue/cloudflare-token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
LESSONCUE_TUNNEL_UNIT
  install -m 0644 "${temporary}" /etc/systemd/system/lessoncue-cloudflared.service
  rm -f "${temporary}"
}
CLOUDFLARED_PINNED_VERSION=2026.7.2
write_connector_result() {
  local version="$1" error="$2" result=/var/lib/lessoncue/config/cloudflared-result.json temporary version_json=null
  if [[ -n "${version}" ]]; then version_json="\"${version}\""; fi
  temporary="$(mktemp)"
  if [[ -n "${error}" ]]; then
    printf '{"installedVersion":%s,"checkedAt":"%s","error":"%s"}\n' \
      "${version_json}" "$(date --iso-8601=seconds)" "${error}" > "${temporary}"
  else
    printf '{"installedVersion":%s,"checkedAt":"%s","error":null}\n' \
      "${version_json}" "$(date --iso-8601=seconds)" > "${temporary}"
  fi
  install -o lessoncue -g lessoncue -m 0600 "${temporary}" "${result}"
  rm -f "${temporary}"
}
set_cloudflared_asset() {
  case "$(uname -m)" in
    x86_64|amd64)
      CLOUDFLARED_ASSET=cloudflared-linux-amd64
      CLOUDFLARED_SHA256=ec905ea7b7e327ff8abdde8cb64697a2152de74dbcdbf6aec9db8364eb3886cd ;;
    aarch64|arm64)
      CLOUDFLARED_ASSET=cloudflared-linux-arm64
      CLOUDFLARED_SHA256=405df476437e027fc6d18729a5a77155c0a33a6082aeee60a799a688f3052e66 ;;
    *)
      CLOUDFLARED_PREPARE_ERROR="Cloudflare Tunnel is not packaged for this CPU architecture."
      return 1 ;;
  esac
}
prepare_cloudflared() {
  local current_version="" cache_dir=/var/cache/lessoncue cache_file download_file active=false previous=/usr/local/bin/cloudflared.previous
  CLOUDFLARED_PREPARE_ERROR=""
  if ! set_cloudflared_asset; then
    write_connector_result "" "${CLOUDFLARED_PREPARE_ERROR}"
    return 1
  fi
  if [[ -x /usr/local/bin/cloudflared ]]; then
    current_version="$(/usr/local/bin/cloudflared --version 2>/dev/null | awk '{print $3}' | head -n 1 || true)"
    if [[ "${current_version}" =~ ^[0-9]{4}\.[0-9]+\.[0-9]+$ ]] &&
       [[ "${current_version}" != "${CLOUDFLARED_PINNED_VERSION}" ]] &&
       [[ "$(printf '%s\n' "${CLOUDFLARED_PINNED_VERSION}" "${current_version}" | sort -V | head -n 1)" == "${CLOUDFLARED_PINNED_VERSION}" ]]; then
      write_connector_result "${current_version}" ""
      return 0
    fi
    if [[ "${current_version}" == "${CLOUDFLARED_PINNED_VERSION}" ]] &&
       printf '%s  %s\n' "${CLOUDFLARED_SHA256}" /usr/local/bin/cloudflared | sha256sum -c - >/dev/null 2>&1; then
      install -d -o root -g root -m 0755 "${cache_dir}"
      cache_file="${cache_dir}/${CLOUDFLARED_ASSET}-${CLOUDFLARED_PINNED_VERSION}"
      install -o root -g root -m 0755 /usr/local/bin/cloudflared "${cache_file}"
      write_connector_result "${current_version}" ""
      return 0
    fi
  fi

  install -d -o root -g root -m 0755 "${cache_dir}"
  cache_file="${cache_dir}/${CLOUDFLARED_ASSET}-${CLOUDFLARED_PINNED_VERSION}"
  if [[ ! -f "${cache_file}" ]] ||
     ! printf '%s  %s\n' "${CLOUDFLARED_SHA256}" "${cache_file}" | sha256sum -c - >/dev/null 2>&1; then
    download_file="$(mktemp)"
    if ! curl -fL "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_PINNED_VERSION}/${CLOUDFLARED_ASSET}" -o "${download_file}"; then
      rm -f "${download_file}"
      CLOUDFLARED_PREPARE_ERROR="The official Cloudflare connector could not be pre-downloaded. Check this server's internet connection."
      write_connector_result "${current_version}" "${CLOUDFLARED_PREPARE_ERROR}"
      return 1
    fi
    if ! printf '%s  %s\n' "${CLOUDFLARED_SHA256}" "${download_file}" | sha256sum -c -; then
      rm -f "${download_file}"
      CLOUDFLARED_PREPARE_ERROR="The Cloudflare connector checksum did not match; the installed connector was not changed."
      write_connector_result "${current_version}" "${CLOUDFLARED_PREPARE_ERROR}"
      return 1
    fi
    chmod 0755 "${download_file}"
    if ! "${download_file}" --version >/dev/null; then
      rm -f "${download_file}"
      CLOUDFLARED_PREPARE_ERROR="The downloaded Cloudflare connector could not run on this server."
      write_connector_result "${current_version}" "${CLOUDFLARED_PREPARE_ERROR}"
      return 1
    fi
    install -o root -g root -m 0755 "${download_file}" "${cache_file}"
    rm -f "${download_file}"
  fi

  systemctl is-active --quiet lessoncue-cloudflared.service 2>/dev/null && active=true
  rm -f "${previous}"
  if [[ -x /usr/local/bin/cloudflared ]]; then cp -a /usr/local/bin/cloudflared "${previous}"; fi
  install -o root -g root -m 0755 "${cache_file}" /usr/local/bin/cloudflared.new
  mv -f /usr/local/bin/cloudflared.new /usr/local/bin/cloudflared
  current_version="$(/usr/local/bin/cloudflared --version 2>/dev/null | awk '{print $3}' | head -n 1 || true)"
  if [[ "${active}" == true ]] && ! systemctl restart lessoncue-cloudflared.service; then
    if [[ -f "${previous}" ]]; then mv -f "${previous}" /usr/local/bin/cloudflared; systemctl restart lessoncue-cloudflared.service || true; fi
    CLOUDFLARED_PREPARE_ERROR="The updated connector could not restart; LessonCue restored the previous connector."
    write_connector_result "$(/usr/local/bin/cloudflared --version 2>/dev/null | awk '{print $3}' | head -n 1 || true)" "${CLOUDFLARED_PREPARE_ERROR}"
    return 1
  fi
  rm -f "${previous}"
  write_connector_result "${current_version}" ""
}
if [[ "${REQUEST}" == connector:prepare ]]; then
  if prepare_cloudflared; then
    echo "Cloudflare connector $(/usr/local/bin/cloudflared --version | awk '{print $3}') is verified and ready."
    exit 0
  fi
  echo "${CLOUDFLARED_PREPARE_ERROR}"
  exit 1
fi
# Docker, from the distribution where it packages a usable Compose plugin, and
# from Docker's own signed repository where it does not. Deliberately quiet
# about failure: the caller turns that into something an administrator reads.
install_docker_for_shortener() {
  local id="" codename="" architecture=""
  command -v apt-get >/dev/null 2>&1 || return 1

  apt-get update >/dev/null 2>&1 || true
  if apt-get install -y docker.io docker-compose-v2 >/dev/null 2>&1 ||
     apt-get install -y docker.io docker-compose-plugin >/dev/null 2>&1; then
    command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1 && return 0
  fi

  # Fall through to Docker's repository, which is what the LessonCue installer
  # does when the distribution has no Compose v2 package.
  [[ -r /etc/os-release ]] || return 1
  # shellcheck disable=SC1091
  id="$(. /etc/os-release && printf '%s' "${ID}")"
  codename="$(. /etc/os-release && printf '%s' "${VERSION_CODENAME:-}")"
  [[ -z "${codename}" ]] && command -v lsb_release >/dev/null 2>&1 && codename="$(lsb_release -cs 2>/dev/null || true)"
  [[ -n "${id}" && -n "${codename}" ]] || return 1
  command -v dpkg >/dev/null 2>&1 || return 1
  architecture="$(dpkg --print-architecture)"

  install -m 0755 -d /etc/apt/keyrings || return 1
  curl -fsSL "https://download.docker.com/linux/${id}/gpg" | gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg || return 1
  chmod a+r /etc/apt/keyrings/docker.gpg
  printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/%s %s stable\n' \
    "${architecture}" "${id}" "${codename}" > /etc/apt/sources.list.d/docker.list
  apt-get update >/dev/null 2>&1 || return 1
  apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin >/dev/null 2>&1 || return 1

  systemctl enable --now docker >/dev/null 2>&1 || true
  command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1
}

write_shortener_result() {
  local ok="$1" domain="$2" error="$3" result=/var/lib/lessoncue/config/shortener-result.json temporary
  temporary="$(mktemp)"
  if [[ -n "${error}" ]]; then
    printf '{"installed":%s,"domain":"%s","appliedAt":"%s","error":"%s"}\n' \
      "${ok}" "${domain}" "$(date --iso-8601=seconds)" "${error}" > "${temporary}"
  else
    printf '{"installed":%s,"domain":"%s","appliedAt":"%s","error":null}\n' \
      "${ok}" "${domain}" "$(date --iso-8601=seconds)" > "${temporary}"
  fi
  install -o lessoncue -g lessoncue -m 0600 "${temporary}" "${result}"
  rm -f "${temporary}"
}

if [[ "${REQUEST}" == shortener:install ]]; then
  MARKER=/var/lib/lessoncue/config/shortener-domain
  SHORTENER_DIR=/opt/lessoncue-shortener
  SHORTENER_DATA=/var/lib/lessoncue/shortener

  if [[ ! -s "${MARKER}" ]]; then
    write_shortener_result false "" "No short domain was recorded."
    exit 1
  fi
  SHORT_DOMAIN="$(tr -d '[:space:]' < "${MARKER}")"
  ROOT_REDIRECT="$(cat /var/lib/lessoncue/config/shortener-root-redirect 2>/dev/null || true)"

  # Install Docker rather than refuse for the want of it. This runs as root and
  # is the same thing the LessonCue installer does; asking an administrator to
  # go and do it by hand is asking them to do our job.
  if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
    echo "Installing Docker so the URL shortener can run."
    if ! install_docker_for_shortener; then
      write_shortener_result false "${SHORT_DOMAIN}" \
        "Docker could not be installed automatically. Install Docker with the Compose plugin, then turn the shortener on again."
      exit 1
    fi
  fi

  INSTALLED_VERSION="$(cat /var/lib/lessoncue/config/installed-version 2>/dev/null || true)"
  if [[ -z "${INSTALLED_VERSION}" ]]; then
    write_shortener_result false "${SHORT_DOMAIN}" "This server does not know which release it is running."
    exit 1
  fi

  SHORTENER_WORK="$(mktemp -d)"
  trap 'rm -rf "${SHORTENER_WORK}"' EXIT
  BUNDLE=LessonCue-URL-Shortener.tar.gz
  BASE="https://github.com/nickhighland/lessoncue/releases/download/v${INSTALLED_VERSION#v}"

  # Checked against the signed checksums, the same as every other download.
  if ! curl -fL "${BASE}/${BUNDLE}" -o "${SHORTENER_WORK}/${BUNDLE}" 2>/dev/null ||
     ! curl -fL "${BASE}/SHA256SUMS" -o "${SHORTENER_WORK}/SHA256SUMS" 2>/dev/null; then
    write_shortener_result false "${SHORT_DOMAIN}" "This release does not carry the URL shortener bundle."
    exit 1
  fi
  if ! grep -F "  ${BUNDLE}" "${SHORTENER_WORK}/SHA256SUMS" > "${SHORTENER_WORK}/bundle.sha256" ||
     ! ( cd "${SHORTENER_WORK}" && sha256sum -c bundle.sha256 >/dev/null ); then
    write_shortener_result false "${SHORT_DOMAIN}" "The URL shortener bundle did not match its checksum."
    exit 1
  fi

  install -d -m 755 "${SHORTENER_DIR}"
  tar -xzf "${SHORTENER_WORK}/${BUNDLE}" -C "${SHORTENER_DIR}" --strip-components=1
  chmod +x "${SHORTENER_DIR}"/*.sh 2>/dev/null || true
  install -d -m 750 "${SHORTENER_DATA}"

  if ( cd "${SHORTENER_DIR}" \
       && SHORTENER_DATA_DIR="${SHORTENER_DATA}" \
          LESSONCUE_DATA_PATH=/var/lib/lessoncue \
          SHORT_DOMAIN_ROOT_REDIRECT="${ROOT_REDIRECT}" \
          ./install.sh "${SHORT_DOMAIN}" ); then
    write_shortener_result true "${SHORT_DOMAIN}" ""
    echo "The LessonCue URL shortener is installed for ${SHORT_DOMAIN}."
    exit 0
  fi

  write_shortener_result false "${SHORT_DOMAIN}" "The shortener did not start. Check: docker compose --profile shortener logs"
  exit 1
fi

if [[ "${REQUEST}" == tunnel:disable ]]; then
  systemctl disable --now lessoncue-cloudflared.service >/dev/null 2>&1 || true
  rm -f /etc/lessoncue/cloudflare-token /var/lib/lessoncue/config/cloudflare-token.pending
  if [[ -f /etc/systemd/system/lessoncue-cloudflared.service ]]; then SERVICE_INSTALLED=true; else SERVICE_INSTALLED=false; fi
  write_tunnel_result false false "${SERVICE_INSTALLED}" ""
  echo "LessonCue Cloudflare Tunnel is disabled."
  exit 0
fi

if [[ "${REQUEST}" == tunnel:enable ]]; then
  TOKEN_PENDING=/var/lib/lessoncue/config/cloudflare-token.pending
  TOKEN_INSTALLED=/etc/lessoncue/cloudflare-token
  if systemctl is-active --quiet cloudflared.service 2>/dev/null; then
    rm -f /var/lib/lessoncue/config/cloudflare-token.pending
    write_tunnel_result false false true "Another cloudflared service is already active. Add LessonCue to that tunnel manually or stop it before enabling LessonCue integration."
    exit 1
  fi
  if [[ -f "${TOKEN_PENDING}" ]]; then TOKEN="$(tr -d '[:space:]' < "${TOKEN_PENDING}")"
  elif [[ -f "${TOKEN_INSTALLED}" ]]; then TOKEN="$(tr -d '[:space:]' < "${TOKEN_INSTALLED}")"
  else
    write_tunnel_result false false true "A Cloudflare tunnel token is required."
    exit 1
  fi
  if [[ ! "${TOKEN}" =~ ^[A-Za-z0-9._=+/-]{50,4096}$ ]]; then
    rm -f "${TOKEN_PENDING}"
    write_tunnel_result false false true "The Cloudflare tunnel token was rejected."
    exit 1
  fi

  if ! prepare_cloudflared; then
    rm -f "${TOKEN_PENDING}"
    write_tunnel_result false false false "${CLOUDFLARED_PREPARE_ERROR}"
    exit 1
  fi

  id lessoncue-tunnel >/dev/null 2>&1 || useradd --system --home /var/lib/lessoncue-tunnel --create-home --shell /usr/sbin/nologin lessoncue-tunnel
  install -d -o root -g lessoncue-tunnel -m 0750 /etc/lessoncue
  TOKEN_TEMP="$(mktemp)"
  printf '%s\n' "${TOKEN}" > "${TOKEN_TEMP}"
  install -o root -g lessoncue-tunnel -m 0640 "${TOKEN_TEMP}" "${TOKEN_INSTALLED}"
  rm -f "${TOKEN_TEMP}" "${TOKEN_PENDING}"
  install_tunnel_unit
  systemctl daemon-reload
  systemctl enable lessoncue-cloudflared.service >/dev/null
  if ! systemctl restart lessoncue-cloudflared.service >/dev/null; then
    write_tunnel_result false true true "The protected Cloudflare Tunnel service could not start. Check journalctl -u lessoncue-cloudflared."
    exit 1
  fi
  # Cloudflare may need time to fall back from QUIC to HTTP/2 on networks that
  # block UDP. Keep the connector installed and retrying instead of turning a
  # slow first handshake into a permanently disabled service.
  for _ in {1..60}; do
    if curl -fsS http://127.0.0.1:60123/metrics 2>/dev/null | grep -Eq '^cloudflared_tunnel_ha_connections [1-9][0-9]*(\.[0-9]+)?$'; then
      write_tunnel_result true true true ""
      echo "LessonCue Cloudflare Tunnel is connected."
      exit 0
    fi
    sleep 1
  done
  write_tunnel_result true true true "The connector is installed and will keep retrying, but no Cloudflare edge connection is active yet. Check the tunnel token and allow outbound TCP or UDP port 7844, then review journalctl -u lessoncue-cloudflared."
  echo "LessonCue Cloudflare Tunnel is running and waiting for a Cloudflare edge connection."
  exit 0
fi

if [[ "${REQUEST}" == hostname:* ]]; then
  LOCAL_HOSTNAME="${REQUEST#hostname:}"
  if [[ ! "${LOCAL_HOSTNAME}" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
    echo "LessonCue rejected an invalid local hostname."
    exit 1
  fi
  if [[ ! -f /etc/avahi/avahi-daemon.conf ]]; then
    echo "Avahi is not installed; the LessonCue .local address cannot be configured."
    exit 1
  fi

  AVAHI_CONFIG="$(mktemp)"
  trap 'rm -f "${AVAHI_CONFIG}"' EXIT
  awk -v hostname="${LOCAL_HOSTNAME}" '
    BEGIN { in_server = 0; server_found = 0; hostname_written = 0 }
    /^\[server\][[:space:]]*$/ {
      print
      in_server = 1
      server_found = 1
      next
    }
    /^\[/ {
      if (in_server && !hostname_written) {
        print "host-name=" hostname
        hostname_written = 1
      }
      in_server = 0
    }
    in_server && /^[#[:space:]]*host-name[[:space:]]*=/ {
      if (!hostname_written) {
        print "host-name=" hostname
        hostname_written = 1
      }
      next
    }
    { print }
    END {
      if (in_server && !hostname_written) print "host-name=" hostname
      if (!server_found) {
        print ""
        print "[server]"
        print "host-name=" hostname
      }
    }
  ' /etc/avahi/avahi-daemon.conf > "${AVAHI_CONFIG}"
  install -m 0644 "${AVAHI_CONFIG}" /etc/avahi/avahi-daemon.conf
  HTTP_PORT="$(cat /var/lib/lessoncue/config/http-port 2>/dev/null || printf '8080')"
  set_avahi_port "${HTTP_PORT}"
  systemctl restart avahi-daemon
  printf '%s\n' "${LOCAL_HOSTNAME}" > /var/lib/lessoncue/config/hostname-result
  chown lessoncue:lessoncue /var/lib/lessoncue/config/hostname-result
  chmod 0600 /var/lib/lessoncue/config/hostname-result
  echo "LessonCue is available at $(format_address "${LOCAL_HOSTNAME}" "${HTTP_PORT}")"
  exit 0
fi

if [[ "${REQUEST}" == port:* ]]; then
  HTTP_PORT="${REQUEST#port:}"
  if [[ ! "${HTTP_PORT}" =~ ^[0-9]+$ ]] || (( HTTP_PORT < 1 || HTTP_PORT > 65535 )); then
    echo "LessonCue rejected an invalid HTTP port."
    exit 1
  fi

  # Give the web request time to return before restarting its server.
  sleep 2
  PREVIOUS_PORT="$(cat /var/lib/lessoncue/config/http-port.previous 2>/dev/null || printf '8080')"
  LOCAL_HOSTNAME="$(cat /var/lib/lessoncue/config/local-hostname 2>/dev/null || printf 'lessoncue')"
  set_avahi_port "${HTTP_PORT}"
  if command -v ufw >/dev/null 2>&1; then ufw allow "${HTTP_PORT}/tcp" >/dev/null || true; fi
  systemctl restart avahi-daemon || true
  systemctl restart lessoncue.service || true
  for _ in {1..30}; do
    if curl -fsS "http://127.0.0.1:${HTTP_PORT}/health/ready" >/dev/null; then
      printf '%s\n' "${HTTP_PORT}" > /var/lib/lessoncue/config/port-result
      chown lessoncue:lessoncue /var/lib/lessoncue/config/port-result
      chmod 0600 /var/lib/lessoncue/config/port-result
      rm -f /var/lib/lessoncue/config/http-port.previous /var/lib/lessoncue/config/port-error
      echo "LessonCue is available at $(format_address "${LOCAL_HOSTNAME}" "${HTTP_PORT}")"
      exit 0
    fi
    sleep 1
  done

  printf '%s\n' "${PREVIOUS_PORT}" > /var/lib/lessoncue/config/http-port
  set_avahi_port "${PREVIOUS_PORT}"
  printf 'Port %s could not be opened. LessonCue returned to port %s. Another service may already be using the requested port.\n' "${HTTP_PORT}" "${PREVIOUS_PORT}" > /var/lib/lessoncue/config/port-error
  chown lessoncue:lessoncue /var/lib/lessoncue/config/http-port /var/lib/lessoncue/config/port-error
  chmod 0600 /var/lib/lessoncue/config/http-port /var/lib/lessoncue/config/port-error
  systemctl restart avahi-daemon || true
